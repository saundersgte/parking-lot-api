{
    "Version": "2012-10-17",
    "Statement": [
    {
        "Sid": "ManageLambdaFunctions",
        "Effect": "Allow",
        "Action": [
            "lambda:CreateFunction",
            "lambda:GetFunction",
            "lambda:GetFunctionConfiguration",
            "lambda:UpdateFunctionCode",
            "lambda:UpdateFunctionConfiguration",
            "lambda:DeleteFunction",
            "lambda:AddPermission",
            "lambda:RemovePermission",
            "lambda:GetPolicy",
            "lambda:TagResource",
            "lambda:ListTags"
        ],
        "Resource": "arn:aws:lambda:us-west-2:614190303686:function:parking-*"
    },
    {
        "Sid": "ManageParkingRoles",
        "Effect": "Allow",
        "Action": [
            "iam:CreateRole",
            "iam:GetRole",
            "iam:DeleteRole",
            "iam:TagRole",
            "iam:ListRoleTags",
            "iam:PutRolePolicy",
            "iam:GetRolePolicy",
            "iam:DeleteRolePolicy",
            "iam:ListRolePolicies",
            "iam:ListAttachedRolePolicies"
        ],
        "Resource": "arn:aws:iam::614190303686:role/parking-*"
    },
    {
        "Sid": "PassRoleToLambdaOnly",
        "Effect": "Allow",
        "Action": "iam:PassRole",
        "Resource": "arn:aws:iam::614190303686:role/parking-*",
        "Condition": {
            "StringEquals": {
                "iam:PassedToService": "lambda.amazonaws.com"
            }
        }
    },
    {
        "Sid": "ManageHttpApis",
        "Effect": "Allow",
        "Action": [
            "apigateway:GET",
            "apigateway:POST",
            "apigateway:PATCH",
            "apigateway:PUT",
            "apigateway:DELETE"
        ],
        "Resource": [
            "arn:aws:apigateway:us-west-2::/apis",
            "arn:aws:apigateway:us-west-2::/apis/*",
            "arn:aws:apigateway:us-west-2::/tags/*"
        ]
    },
    {
       "Sid": "ManageLambdaLogGroups",
       "Effect": "Allow",
       "Action": [
        "logs:CreateLogGroup",
        "logs:DescribeLogGroups",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:TagResource",
        "logs:ListTagsForResource"
       ],
       "Resource": "arn:aws:logs:us-west-2:614190303686:log-group:/aws/lambda/parking-*"
    },
    {
        "Sid": "ManageAndUseParkingTables",
        "Effect": "Allow",
        "Action": [
            "dynamodb:CreateTable",
            "dynamodb:DescribeTable",
            "dynamodb:DescribeTimeToLive",
            "dynamodb:DescribeContinuousBackups",
            "dynamodb:UpdateTable",
            "dynamodb:DeleteTable",
            "dynamodb:TagResource",
            "dynamodb:ListTagsOfResource",
            "dynamodb:GetItem",
            "dynamodb:PutItem",
            "dynamodb:DeleteItem",
            "dynamodb:Scan"
        ],
        "Resource": "arn:aws:dynamodb:us-west-2:614190303686:table/parking_*"
    }
    ]
}